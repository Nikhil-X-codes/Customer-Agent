# Copy to .env, keep it private, and fill the real values below.
# See docs/ENVIRONMENT.md for every value and the API/OIDC and database/signed choices.
# The app refuses to start without a current operational source.
APP_MODE=production
AGENT_DOMAIN=supply_chain

# Choose exactly ONE real read-only source. Leave the other URL/path empty.
# Example API: https://supply-api.company.example (must implement docs/REAL_DATA.md).
SUPPLY_API_URL=
SUPPLY_API_TOKEN=
# SUPPLY_DB_PATH=/absolute/path/to/current-erp-sync.db
SUPPLY_MAX_SYNC_AGE_MINUTES=30

# Required for AUTH_MODE=signed. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# AUTH_MODE=signed uses SESSION_SECRET from a trusted company token issuer.
# For company OIDC access tokens, use these instead (HTTPS JWKS and RS256):
# AUTH_MODE=oidc
# OIDC_ISSUER=https://id.company.example
# OIDC_AUDIENCE=customer-agent
# OIDC_JWKS_URL=https://id.company.example/.well-known/jwks.json
# OIDC_ROLE_CLAIM=roles
# OIDC_REQUIRED_ROLE=operations
# Absolute, persistent path for tickets reviewed by your operations team.
# Docker Compose overrides this to /app/var/handoffs.db; use a host path for local runs.
HANDOFF_DB_PATH=/absolute/path/to/persistent/handoffs.db
HTTP_MAX_WORKERS=32
CHAT_RATE_LIMIT_PER_MINUTE=30

# Start with deterministic mode. To enable tool-calling agents, change to
# AI_MODE=groq and SUPPLY_AGENT_MODE=multi after adding BOTH provider keys.
AI_MODE=off
SUPPLY_AGENT_MODE=deterministic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional approved-document answers. Production Qdrant must use HTTPS.
# Requires AI_MODE=groq, GROQ_API_KEY, and ADMIN_API_KEY for serving uploads.
# QDRANT_URL=https://your-qdrant-host
# QDRANT_API_KEY=
# QDRANT_COLLECTION=supply_chain_live_knowledge_v1
EMBEDDING_CACHE_PATH=/absolute/path/to/model-cache
# Required when QDRANT_URL is configured and serving document uploads.
ADMIN_API_KEY=
